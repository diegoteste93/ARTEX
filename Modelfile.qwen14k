FROM qwen3:8b
# Denso 8B (~5 GB Q4): CABE INTEIRO nos 8 GB de VRAM da RTX 3080 Laptop -> rapido,
# sem offload pra RAM e sem os timeouts do MoE 30B. No benchmark local o qwen3:8b
# passou nos testes de tool-calling que os 14B falharam, entao agencia + velocidade.
# Mantemos o tag "qwen14k" pra reusar o profile LLM ja gravado no banco.
# Contexto 24k: folga pra KV cache caber na VRAM junto com o modelo.
PARAMETER num_ctx 24576
# Sampling recomendado pelo time do Qwen para qwen3 em modo thinking.
# NAO usar temperature 0 (greedy) com qwen3 thinking -> causa loop de repeticao.
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
